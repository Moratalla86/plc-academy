{
  "name": "@plc-academy/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build ../../crates/plc-runtime --target web --out-dir ../../apps/web/src/wasm --out-name plc_runtime --no-pack"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "wasm-pack": "^0.15.0"
  }
}
